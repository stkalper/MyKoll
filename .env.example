# Public HTTPS URL of the deployment (Mini App, share links, webhook)
PUBLIC_URL=https://your-app.vercel.app
# Postgres connection string (Neon). Leave empty locally to use embedded PGlite in .data/
DATABASE_URL=
# Zone used to read deadlines like "by Friday"
TIMEZONE=Europe/Kyiv
# Shared secret for the cron endpoint (Vercel sends it as a Bearer token)
CRON_SECRET=

# Telegram: bot token from @BotFather, and any random string for webhook signing
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Tatum: Price API + Sui gRPC gateway
TATUM_API_KEY=
TATUM_SUI_GRPC_HOST=sui-mainnet-grpc.gateway.tatum.io:443

# Walrus Memory: delegate key (hex) and account ID (0x...) from https://memory.walrus.xyz
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE_PREFIX=receipts

# Any OpenAI-compatible endpoint: Groq, OpenRouter, Together, Ollama, ...
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
